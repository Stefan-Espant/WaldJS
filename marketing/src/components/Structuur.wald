---
import { ui } from '../lib/strings'
---
<section id="structure">
  <div class="split">
    <div class="code-block">
      <div class="title"><span class="dot"></span>{ui.structure.caption}</div>
      <pre>my-forest/
├── content/
│   └── blog/
│       └── hello-world.md
├── src/
│   ├── layouts/
│   │   └── Layout.wald
│   ├── components/
│   │   └── Card.wald
│   └── pages/
│       ├── index.wald
│       └── blog/
│           ├── index.wald
│           └── [slug].wald
├── public/           <span class="c-c"># {ui.structure.publicNote}</span>
├── wald.config.ts    <span class="c-c"># {ui.structure.optional}</span>
└── package.json</pre>
    </div>
    <div class="text">
      <h2><span class="tag">{ui.structure.tag}</span>
        {ui.structure.title}</h2>
      <p>{ui.structure.config}</p>
      <div class="code-block" style="margin-top:18px">
        <div class="title"><span class="dot"></span>wald.config.ts</div>
        <pre><span class="c-k">import</span> &#123; defineConfig, vercelAdapter &#125; <span class="c-k">from</span> <span class="c-s">'@waldjs/cli'</span>

<span class="c-k">export default</span> defineConfig(&#123;
  adapter: vercelAdapter(),
  base: <span class="c-s">'/'</span>,
  vite: &#123; plugins: [] &#125;,
&#125;)</pre>
      </div>
    </div>
  </div>
</section>
