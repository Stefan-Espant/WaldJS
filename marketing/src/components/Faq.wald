---
import { ui } from '../lib/strings'
---
<section id="faq">
  <div class="section-heading">
    <span class="tag">FAQ</span>
    <h2>{ui.faq.title}</h2>
  </div>
  <div class="faq">
    <details>
      <summary>{ui.faq.whyQ}</summary>
      <p>{ui.faq.whyA}</p>
    </details>
    <details>
      <summary>{ui.faq.productionQ}</summary>
      <p>{ui.faq.productionA}</p>
    </details>
    <details>
      <summary>{ui.faq.migrateQ}</summary>
      <p>{ui.faq.migrateA}</p>
    </details>
    <details>
      <summary>{ui.faq.viteQ}</summary>
      <p>{ui.faq.viteA}</p>
    </details>
  </div>
</section>
