---
import { ui } from '../lib/strings'
// Measured with `pnpm bench` in benchmarks/ (median of 7 builds after 2
// warm-ups; Apple M1 Pro, Node 22). Bars are relative to the slowest result
// in each group. Update the numbers here and in benchmarks/benchmark.html
// together after a new run.
---
<section class="full" id="benchmarks" style="padding:90px 6vw">
  <div class="bench">
    <div class="section-heading" style="margin-bottom:0">
      <span class="tag">Benchmarks</span>
      <h2>{ui.benchmarks.title}</h2>
      <p>{ui.benchmarks.intro}</p>
    </div>
    <div class="bench-grid">
      <div class="stat-group">
        <h3>⚡ {ui.benchmarks.buildLarge}</h3>
        <span class="metric">{ui.benchmarks.lowerIsBetter}</span>
        <div class="stat wald"><div class="label"><b>WaldJS</b><span class="value">{ui.benchmarks.wald1000}</span></div><div class="bar"><i style="width:10.7%"></i></div></div>
        <div class="stat"><div class="label"><b>Eleventy 3.1</b><span class="value">{ui.benchmarks.eleventy1000}</span></div><div class="bar"><i style="width:13.1%"></i></div></div>
        <div class="stat"><div class="label"><b>Astro 4.16</b><span class="value">{ui.benchmarks.astro1000}</span></div><div class="bar"><i style="width:100%"></i></div></div>
      </div>
      <div class="stat-group">
        <h3>🌱 {ui.benchmarks.buildSmall}</h3>
        <span class="metric">{ui.benchmarks.lowerIsBetter}</span>
        <div class="stat wald"><div class="label"><b>WaldJS</b><span class="value">{ui.benchmarks.wald50}</span></div><div class="bar"><i style="width:35.7%"></i></div></div>
        <div class="stat"><div class="label"><b>Eleventy 3.1</b><span class="value">{ui.benchmarks.eleventy50}</span></div><div class="bar"><i style="width:30.8%"></i></div></div>
        <div class="stat"><div class="label"><b>Astro 4.16</b><span class="value">{ui.benchmarks.astro50}</span></div><div class="bar"><i style="width:100%"></i></div></div>
      </div>
    </div>
    <p class="disclaimer">{ui.benchmarks.disclaimer}</p>
  </div>
</section>
