---
import { ui } from '../lib/strings'
---
<section class="full" id="benchmarks" style="padding:90px 6vw">
  <div class="bench">
    <div class="section-heading" style="margin-bottom:0">
      <span class="tag">Benchmarks</span>
      <h2>{ui.benchmarks.title}</h2>
      <p>{ui.benchmarks.intro}</p>
    </div>
    <div class="bench-grid">
      <div class="stat-group">
        <h3>⚡ {ui.benchmarks.buildTime}</h3>
        <span class="metric">{ui.benchmarks.buildTimeNote}</span>
        <div class="stat wald"><div class="label"><b>WaldJS</b><span class="value">1,1 s</span></div><div class="bar"><i style="width:22%"></i></div></div>
        <div class="stat"><div class="label"><b>Eleventy</b><span class="value">1,9 s</span></div><div class="bar"><i style="width:38%"></i></div></div>
        <div class="stat"><div class="label"><b>Astro</b><span class="value">4,9 s</span></div><div class="bar"><i style="width:98%"></i></div></div>
      </div>
      <div class="stat-group">
        <h3>🌱 {ui.benchmarks.devStart}</h3>
        <span class="metric">{ui.benchmarks.devStartNote}</span>
        <div class="stat wald"><div class="label"><b>WaldJS</b><span class="value">140 ms</span></div><div class="bar"><i style="width:28%"></i></div></div>
        <div class="stat"><div class="label"><b>Eleventy</b><span class="value">210 ms</span></div><div class="bar"><i style="width:42%"></i></div></div>
        <div class="stat"><div class="label"><b>Astro</b><span class="value">480 ms</span></div><div class="bar"><i style="width:96%"></i></div></div>
      </div>
      <div class="stat-group">
        <h3>📦 {ui.benchmarks.js}</h3>
        <span class="metric">{ui.benchmarks.jsNote}</span>
        <div class="stat wald">
          <div class="label"><b>WaldJS</b><span class="value">0,10 KB</span></div>
          <div class="bar"><i style="width:10%"></i></div>
        </div>
        <div class="stat">
          <div class="label"><b>Eleventy</b><span class="value">1,05 KB</span></div>
          <div class="bar"><i style="width:100%"></i></div>
        </div>
        <div class="stat">
          <div class="label"><b>Astro</b><span class="value">0,11 KB</span></div>
          <div class="bar"><i style="width:10.3%"></i></div>
        </div>
      </div>
    </div>
  </div>
</section>
