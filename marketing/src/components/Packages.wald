---
import { ui } from '../lib/strings'
---
<section id="packages" style="padding-top:40px">
  <div class="section-heading">
    <span class="tag">Packages</span>
    <h2>{ui.packages.title}</h2>
  </div>
  <div class="pkg">
    <span><b>@waldjs/cli</b> · plant, grow, build, preview</span>
    <span><b>@waldjs/compiler</b> · {ui.packages.compiler}</span>
    <span><b>@waldjs/runtime</b> · createTree, renderTemplate</span>
    <span><b>@waldjs/content</b> · readCollection, readEntry</span>
  </div>
</section>
