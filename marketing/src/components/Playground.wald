---
import { ui } from '../lib/strings'
---
<section id="playground">
  <div class="section-heading">
    <span class="tag">Playground</span>
    <h2>{ui.playground.title}</h2>
    <p>{ui.playground.intro}</p>
  </div>
  <div class="pg-grid">
    <div class="code-block">
      <div class="title"><span class="dot"></span>speeltuin.wald</div>
      <textarea id="pg-editor" class="pg-editor" spellcheck="false" aria-label="Wald editor"></textarea>
    </div>
    <div class="pg-preview" id="pg-preview" aria-live="polite"></div>
  </div>
</section>

<!-- BOS METAFOOR -->
