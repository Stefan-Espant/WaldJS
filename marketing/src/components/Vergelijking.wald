<section id="comparison">
  <div class="section-heading">
    <span class="tag"><span class="nl">Vergelijking</span><span class="en">Comparison</span></span>
    <h2><span class="nl">Hoe verhoudt Wald zich?</span><span class="en">How does Wald compare?</span></h2>
  </div>
  <table class="compare">
    <tr><th scope="col">Feature</th><th scope="col">WaldJS</th><th scope="col">Astro</th><th scope="col">Eleventy</th></tr>
    <tr><td><span class="nl">Single-file formaat (frontmatter + template)</span><span class="en">Single-file format (frontmatter + template)</span></td><td class="yes">✓ .wald</td><td class="yes">✓ .astro</td><td class="no">—</td></tr>
    <tr><td>File-based routing</td><td class="yes">✓</td><td class="yes">✓</td><td class="yes">✓</td></tr>
    <tr><td>Content collections</td><td class="yes">✓</td><td class="yes">✓</td><td class="partial"><span class="nl">deels</span><span class="en">partial</span></td></tr>
    <tr><td><span class="nl">0 KB JavaScript standaard</span><span class="en">0 KB JavaScript by default</span></td><td class="yes">✓</td><td class="yes">✓</td><td class="yes">✓</td></tr>
    <tr><td>getStaticPaths()</td><td class="yes">✓</td><td class="yes">✓</td><td class="partial">pagination</td></tr>
    <tr><td><span class="nl">Vite-integratie</span><span class="en">Vite integration</span></td><td class="yes">✓</td><td class="yes">✓</td><td class="no">—</td></tr>
    <tr><td>Partial hydration</td><td class="yes">✓ <span class="nl">canopy's</span><span class="en">canopies</span></td><td class="yes">✓</td><td class="no">—</td></tr>
    <tr><td><span class="nl">Bos-terminologie</span><span class="en">Forest terminology</span></td><td class="yes">🌲</td><td class="no">—</td><td class="no">—</td></tr>
  </table>
</section>

