---
import { getCollection } from 'wald:content'
import { ui } from '../lib/strings'
const entries = await getCollection('changelog')
const recent = entries
  .slice()
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
---
<section id="changelog">
  <div class="section-heading">
    <span class="tag">{ui.common.growthLog}</span>
    <h2>Changelog</h2>
    <p>{ui.changelog.intro}</p>
    <p style="margin-top:.5rem">
      <a href="https://www.npmjs.com/package/@waldjs/cli" target="_blank" rel="noopener">
        <img src="https://img.shields.io/npm/v/@waldjs/cli.svg" alt="npm version" width="80" height="20" style="vertical-align:middle" />
      </a>
      <span style="margin-left:.5rem;opacity:.7;font-size:.85rem">{ui.changelog.npmNote}</span>
    </p>
  </div>
  <div class="changelog">
    {new SafeHtml(recent.map(entry => `
      <div class="log-card">
        <div class="log-header"><h3>${entry.data.title}</h3><span class="date">${entry.data.dateLabel}</span></div>
        ${entry.body}
      </div>
    `).join(''))}
  </div>
  <p style="margin-top:1.5rem">
    <a class="btn ghost" href="/changelog">{ui.changelog.seeAll}</a>
  </p>
</section>
