---
import { ui } from '../lib/strings'
---
<section id="quickstart" style="background:transparent">
  <div class="section-heading">
    <span class="tag">Quick start</span>
    <h2>{ui.quickstart.title}</h2>
    <p>{ui.quickstart.intro}</p>
  </div>
  <div class="qs-grid">
    <div class="code-block">
      <div class="title"><span class="dot"></span>npm</div>
      <pre><span class="c-c"># {ui.quickstart.npm}</span>
npm create wald@latest my-forest
cd my-forest
npm run dev</pre>
    </div>
    <div class="code-block">
      <div class="title"><span class="dot"></span>pnpm</div>
      <pre><span class="c-c"># {ui.quickstart.pnpm}</span>
pnpm create wald my-forest
cd my-forest
pnpm dev</pre>
    </div>
  </div>
</section>

<!-- .WALD FORMAAT -->
