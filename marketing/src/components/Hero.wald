---
import { ui } from '../lib/strings'
---
<header id="top">
  <h1>
    {ui.hero.title}
  </h1>
  <p class="sub">
    {ui.hero.lead}
  </p>
  <div class="cta">
    <a class="btn" href="#quickstart">{ui.hero.cta}</a>
    <a class="btn ghost" href="https://github.com/Stefan-Espant/WaldJS/" target="_blank" rel="noopener">{ui.hero.github}</a>
  </div>
  <div id="gh-stats" class="gh-stats">
    <span>⭐ <b id="gh-stars">–</b> stars</span>
    <span>🍴 <b id="gh-forks">–</b> forks</span>
    <span>{ui.hero.openSource} · <b>MIT</b></span>
  </div>
  <div class="terminal code-block">
    <div class="title"><span class="dot"></span>terminal</div>
    <pre><span id="term-text" class="term-cursor">$ </span>
<span id="term-output" class="term-output"></span></pre>
  </div>
  <p class="plant-hint">{ui.hero.tip}</p>
</header>

<!-- QUICK START -->
