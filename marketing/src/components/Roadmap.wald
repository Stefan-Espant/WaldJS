---
import { ui } from '../lib/strings'
---
<section id="roadmap">
  <div class="section-heading">
    <span class="tag">Roadmap</span>
    <h2>{ui.roadmap.title}</h2>
  </div>
  <ul class="roadmap">
    <li class="done"><b>Phase 0 — Roots <span class="badge complete">✓</span></b><span class="description">{ui.roadmap.compiler}</span></li>
    <li class="done"><b>Phase 1 — Seed <span class="badge complete">✓</span></b><span class="description">CLI: plant, grow, build, preview</span></li>
    <li class="done"><b>Phase 2a — Sapling <span class="badge complete">✓</span></b><span class="description">Content collections + getStaticPaths()</span></li>
    <li class="done"><b>Phase 2b — Branches <span class="badge complete">✓</span></b><span class="description">{ui.roadmap.components}</span></li>
    <li class="done"><b>Phase 3 — Canopy <span class="badge complete">✓</span></b><span class="description">Client-side hydration</span></li>
    <li class="done"><b>Phase 4a — Forest <span class="badge complete">✓</span></b><span class="description">Vite-plugin (vite-plugin-wald)</span></li>
    <li class="done"><b>Phase 4b — Forest <span class="badge complete">✓</span></b><span class="description">wald.config.ts + Vite SSR build-pipeline</span></li>
    <li class="done"><b>Phase 4c — Forest <span class="badge complete">✓</span></b><span class="description">{ui.roadmap.adapters}</span></li>
    <li><b>Phase 5a — Ecosystem</b><span class="description">{ui.roadmap.apiRoutes}</span></li>
    <li><b>Phase 5b — Ecosystem</b><span class="description">{ui.roadmap.viewTransitions}</span></li>
    <li><b>Phase 5c — Ecosystem</b><span class="description">{ui.roadmap.i18n}</span></li>
    <li><b>Phase 5d — Ecosystem</b><span class="description">{ui.roadmap.sitemapRss}</span></li>
    <li><b>Phase 5e — Ecosystem</b><span class="description">{ui.roadmap.middleware}</span></li>
  </ul>
  <p class="roadmap-note">{ui.roadmap.phase5Note}</p>
</section>
