---
import { ui } from '../lib/strings'
---
<section id="format">
  <div class="split">
    <div class="text">
      <h2><span class="tag">{ui.format.tag}</span>
        {ui.format.title}
      </h2>
      <p>{ui.format.frontmatter}</p>
      <p>{ui.format.escaping}</p>
    </div>
    <div class="code-block">
      <div class="title"><span class="dot"></span>src/pages/index.wald</div>
      <pre><span class="c-c">---</span>
<span class="c-k">const</span> title = <span class="c-s">"Hello World"</span>
<span class="c-c">---</span>
<span class="c-t">&lt;h1&gt;</span>&#123;title&#125;<span class="c-t">&lt;/h1&gt;</span>
<span class="c-t">&lt;p&gt;</span>{ui.format.welcome}<span class="c-t">&lt;/p&gt;</span></pre>
    </div>
  </div>
</section>

<!-- PLAYGROUND -->
