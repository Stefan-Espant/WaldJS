---
import { ui } from '../lib/strings'
---
<section id="cli">
  <svg class="fern right" aria-hidden="true"></svg>
  <div class="section-heading">
    <span class="tag">CLI</span>
    <h2>{ui.cli.title}</h2>
  </div>
  <div class="cli-grid">
    <div class="cli-card"><code>wald plant &lt;name&gt;</code><p>{ui.cli.create}</p></div>
    <div class="cli-card"><code>wald grow</code><p>{ui.cli.dev}</p></div>
    <div class="cli-card"><code>wald build</code><p>{ui.cli.build}</p></div>
    <div class="cli-card"><code>wald preview</code><p>{ui.cli.preview}</p></div>
  </div>
</section>
