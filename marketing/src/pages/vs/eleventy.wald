---
import Layout from '../../layouts/Layout.wald'
import Vergelijking from '../../components/Vergelijking.wald'
import { ui } from '../../lib/strings'
---
<Layout
  title="WaldJS vs Eleventy: which static site generator fits your project?"
  description="An honest comparison of WaldJS and Eleventy: single-file components, Vite integration, partial hydration, and when to choose which."
  canonicalPath="/vs/eleventy"
>
  <section id="vs-eleventy-intro" class="page-intro">
    <div class="section-heading">
      <span class="tag">{ui.vs.tag}</span>
      <h1>WaldJS vs Eleventy</h1>
      <p>{ui.vsEleventy.intro}</p>
    </div>
  </section>
  <Vergelijking />
  <section id="vs-eleventy-choice">
    <div class="section-heading">
      <h2>{ui.vs.whenWhich}</h2>
    </div>
    <div class="split">
      <div>
        <h3>{ui.vs.chooseWald}</h3>
        <ul>
          <li>{ui.vsEleventy.wald1}</li>
          <li>{ui.vsEleventy.wald2}</li>
        </ul>
      </div>
      <div>
        <h3>{ui.vsEleventy.chooseEleventy}</h3>
        <ul>
          <li>{ui.vsEleventy.eleventy1}</li>
          <li>{ui.vsEleventy.eleventy2}</li>
        </ul>
      </div>
    </div>
    <p style="margin-top:1.5rem"><a href="/waarom">{ui.vs.readStory}</a></p>
  </section>
</Layout>
