---
import Layout from '../../layouts/Layout.wald'
import Vergelijking from '../../components/Vergelijking.wald'
import { ui } from '../../lib/strings'
---
<Layout
  title="WaldJS vs Astro: which static site framework fits your project?"
  description="An honest comparison of WaldJS and Astro: single-file components, content collections, partial hydration, and when to choose which."
  canonicalPath="/vs/astro"
>
  <section id="vs-astro-intro" class="page-intro">
    <div class="section-heading">
      <span class="tag">{ui.vs.tag}</span>
      <h1>WaldJS vs Astro</h1>
      <p>{ui.vsAstro.intro}</p>
    </div>
  </section>
  <Vergelijking />
  <section id="vs-astro-choice">
    <div class="section-heading">
      <h2>{ui.vs.whenWhich}</h2>
    </div>
    <div class="split">
      <div>
        <h3>{ui.vs.chooseWald}</h3>
        <ul>
          <li>{ui.vsAstro.wald1}</li>
          <li>{ui.vsAstro.wald2}</li>
        </ul>
      </div>
      <div>
        <h3>{ui.vsAstro.chooseAstro}</h3>
        <ul>
          <li>{ui.vsAstro.astro1}</li>
          <li>{ui.vsAstro.astro2}</li>
        </ul>
      </div>
    </div>
    <p style="margin-top:1.5rem"><a href="/waarom">{ui.vs.readStory}</a></p>
  </section>
</Layout>
