{
  "name": "@waldjs/cli",
  "version": "0.12.0",
  "description": "The WaldJS CLI: create, develop and build fast, content-first static websites from .wald single-file components",
  "keywords": [
    "waldjs",
    "static-site-generator",
    "ssg",
    "framework",
    "content-first",
    "vite",
    "typescript",
    "jamstack",
    "cli",
    "markdown",
    "ssr",
    "pre-render",
    "islands",
    "static-site"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stefan-Espant/WaldJS.git",
    "directory": "packages/cli"
  },
  "homepage": "https://waldjs.eu",
  "bugs": {
    "url": "https://github.com/Stefan-Espant/WaldJS/issues"
  },
  "author": "Stefan van der Kort",
  "private": false,
  "type": "module",
  "bin": {
    "wald": "./bin/wald.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@waldjs/canopy": "workspace:*",
    "@waldjs/compiler": "workspace:*",
    "@waldjs/content": "workspace:*",
    "@waldjs/runtime": "workspace:*",
    "citty": "^0.1.6",
    "ora": "^8.0.0",
    "sharp": "^0.33.0",
    "sirv": "^3.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  }
}
